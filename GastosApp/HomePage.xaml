<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GastosApp.HomePage"
    xmlns:viewModels="clr-namespace:GastosApp.ViewModels"
    xmlns:models="clr-namespace:GastosApp.Models"
    x:DataType="viewModels:HomeViewModel"
    Title="Gastos">

    <!--
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding NavegarANuevaTransaccionCommand}" />
    </ContentPage.ToolbarItems>
    -->

    <ScrollView>
        <Grid Padding="20" RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Recuadro "Hola X!" -->
            <Frame Grid.Row="0"
                BackgroundColor="#801EFF"
                CornerRadius="20"
                Padding="20"
                HorizontalOptions="FillAndExpand"
                Margin="0,0,0,-40"
                ZIndex="1">
                <Label x:Name="UserNameLabel" 
                    Text="{Binding UserName, StringFormat='Hola {0} !'}"
                    FontSize="Large"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    TextColor="White" />
            </Frame>

            <!-- Recuadro Balance General -->
            <Frame Grid.Row="1"
                   Padding="20"
                   CornerRadius="10"
                   HasShadow="True"
                   BorderColor="LightGray"
                   Margin="0,40,0,10"
                   ZIndex="0">
                <StackLayout>
                    <Label Text="Balance General" FontSize="Medium" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{Binding Balance, StringFormat='${0:N2}'}" FontSize="Title" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="*,*" Padding="0,10,0,0">
                        <StackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Ingresos" />
                            <Label Text="{Binding Ingresos, StringFormat='${0:N2}'}" TextColor="Green" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Egresos" />
                            <Label Text="{Binding Egresos, StringFormat='${0:N2}'}" TextColor="Red" />
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </Frame>

            <VerticalStackLayout Grid.Row="2" Spacing="15">

                <!-- Botón "+" -->
                <Button Text="＋"
                        Command="{Binding NavegarANuevaTransaccionCommand}"
                        FontSize="22"
                        CornerRadius="40"
                        HorizontalOptions="End"
                        TextColor="White"
                        TranslationY="-15">
                    <Button.Shadow>
                        <Shadow Radius="10" Offset="0,4" Opacity="0.4" />
                    </Button.Shadow>
                </Button>

                <!-- Label Transacciones -->
                <Label Text="Transacciones" FontSize="Medium" FontAttributes="Bold" TranslationY="-30" />
                <!-- Lista de Transacciones -->
                <CollectionView ItemsSource="{Binding Transacciones}" TranslationY="-30">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaccion">
                            <Frame Padding="10" Margin="5" CornerRadius="5" HasShadow="True" BorderColor="LightGray">
                                <StackLayout>
                                    <Label Text="{Binding Glosa}" FontAttributes="Bold" />
                                    <Label Text="{Binding Monto, StringFormat='${0:N2}'}" />
                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Label>
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="Text" Value="Gasto" />
                                                <Setter Property="TextColor" Value="Red" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EsIngreso}" Value="True">
                                                        <Setter Property="Text" Value="Ingreso" />
                                                        <Setter Property="TextColor" Value="Green" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>
                   
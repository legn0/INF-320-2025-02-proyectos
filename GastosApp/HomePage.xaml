<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GastosApp.HomePage"
             xmlns:viewModels="clr-namespace:GastosApp.ViewModels"
             xmlns:models="clr-namespace:GastosApp.Models"
             x:DataType="viewModels:HomeViewModel"
             Title="Resumen de Gastos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding NavegarANuevaTransaccionCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label x:Name="UserNameLabel" Text="{Binding UserName, StringFormat='Hola {0}'}" FontSize="Large" FontAttributes="Bold" HorizontalOptions="Center" />

            <Frame Padding="20" CornerRadius="10" HasShadow="True" BorderColor="LightGray" Margin="0,10">
                <StackLayout>
                    <Label Text="Balance General" FontSize="Medium" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="{Binding Balance, StringFormat='${0:N2}'}" FontSize="Title" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,*" Padding="0,10,0,0">
                        <StackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Ingresos" />
                            <Label Text="{Binding Ingresos, StringFormat='${0:N2}'}" TextColor="Green" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Egresos" />
                            <Label Text="{Binding Egresos, StringFormat='${0:N2}'}" TextColor="Red" />
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </Frame>

            <Label Text="Historial" FontSize="Medium" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Transacciones}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaccion">
                        <Frame Padding="10" Margin="5" CornerRadius="5" HasShadow="True" BorderColor="LightGray">
                            <StackLayout>
                                <Label Text="{Binding Glosa}" FontAttributes="Bold" />
                                <Label Text="{Binding Monto, StringFormat='${0:N2}'}" />
                                <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}" />
                                <Label>
                                    <Label.Style>
                                        <Style TargetType="Label">
                                            <Setter Property="Text" Value="Gasto" />
                                            <Setter Property="TextColor" Value="Red" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding EsIngreso}" Value="True">
                                                    <Setter Property="Text" Value="Ingreso" />
                                                    <Setter Property="TextColor" Value="Green" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Label.Style>
                                </Label>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

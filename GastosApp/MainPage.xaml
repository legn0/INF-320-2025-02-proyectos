<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GastosApp.MainPage"
             Title="Transacciones">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Glosa/Descripción -->
            <Entry Placeholder="Glosa" Text="{Binding Glosa}" />

            <!-- Monto a ingresar -->
            <Entry Placeholder="Monto" Text="{Binding Monto}" Keyboard="Numeric" />
            
            <!-- Casilla para elegir Fecha -->
            <DatePicker Date="{Binding Fecha}" />

            <!-- Casilla Check Ingreso -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="¿Es ingreso?" VerticalOptions="Center" />
                <CheckBox IsChecked="{Binding EsIngreso}" Grid.Column="1" />
            </Grid>

            <!-- Botón para confirmar -->
            <Button Text="Guardar" Command="{Binding AgregarCommand}" />
            <!-- Botón para cancelar -->
            <Button Text="Cancelar"
                BackgroundColor="Red"
                TextColor="White"
                Command="{Binding CancelarCommand}" 
            />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
